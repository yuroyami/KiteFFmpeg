+/* KiteFFmpeg: playlist variables, as EXT-X-DEFINE (RFC 8216bis, section 4.4.2.3) defines them and
+ * section 4.3 says where they are used. A playlist defines a variable by NAME and VALUE, by IMPORT
+ * from the master playlist that led to it, or by QUERYPARAM from the query of its own URL, the
+ * redirected one if it was redirected. A reference is "{$" NAME "}". References are replaced in
+ * URI lines and in the attribute lists of the four tags this demuxer reads: EXT-X-STREAM-INF,
+ * EXT-X-MEDIA, EXT-X-KEY and EXT-X-MAP. A replacement is not replaced again. A reference to a
+ * variable no earlier EXT-X-DEFINE gave fails the playlist, as section 6.3.1 asks. Definitions
+ * live for one load of one playlist; only the master's are kept, for its media playlists to
+ * import. */
+
+#define MAX_VARIABLE_NAME_LEN 256
+
+struct define_info {
+    char name[MAX_VARIABLE_NAME_LEN];
+    char value[MAX_URL_SIZE];
+    char import[MAX_VARIABLE_NAME_LEN];
+    char queryparam[MAX_VARIABLE_NAME_LEN];
+    int has_name, has_value, has_import, has_queryparam;
+};
+
+static void handle_define_args(void *context, const char *key,
+                               int key_len, char **dest, int *dest_len)
+{
+    struct define_info *info = context;
+    if (!strncmp(key, "NAME=", key_len)) {
+        info->has_name = 1;
+        *dest     =        info->name;
+        *dest_len = sizeof(info->name);
+    } else if (!strncmp(key, "VALUE=", key_len)) {
+        info->has_value = 1;
+        *dest     =        info->value;
+        *dest_len = sizeof(info->value);
+    } else if (!strncmp(key, "IMPORT=", key_len)) {
+        info->has_import = 1;
+        *dest     =        info->import;
+        *dest_len = sizeof(info->import);
+    } else if (!strncmp(key, "QUERYPARAM=", key_len)) {
+        info->has_queryparam = 1;
+        *dest     =        info->queryparam;
+        *dest_len = sizeof(info->queryparam);
+    }
+}
+
+/* The characters a variable name may hold: [a-z], [A-Z], [0-9], '-' and '_'. */
+static int is_variable_name_char(char ch)
+{
+    return av_isdigit(ch) || (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+           ch == '-' || ch == '_';
+}
+
+static int is_variable_name(const char *name)
+{
+    size_t len = strlen(name);
+    if (!len || len >= MAX_VARIABLE_NAME_LEN - 1)
+        return 0;
+    for (; *name; name++)
+        if (!is_variable_name_char(*name))
+            return 0;
+    return 1;
+}
+
+/* The percent-decoded value of the first query parameter of url called name, in *value, which the
+ * caller frees. AVERROR(ENOENT) when url has no such parameter, or has it with no value. */
+static int find_query_parameter(const char *url, const char *name, char **value)
+{
+    const char *q = strchr(url, '?');
+    size_t name_len = strlen(name);
+    *value = NULL;
+    if (!q)
+        return AVERROR(ENOENT);
+    for (q++; *q && *q != '#'; ) {
+        size_t len = strcspn(q, "&#");
+        if (len > name_len && !strncmp(q, name, name_len) && q[name_len] == '=') {
+            char *raw = av_strndup(q + name_len + 1, len - name_len - 1);
+            if (!raw)
+                return AVERROR(ENOMEM);
+            *value = ff_urldecode(raw, 0);
+            av_free(raw);
+            return *value ? 0 : AVERROR(ENOMEM);
+        }
+        q += len;
+        if (*q == '&')
+            q++;
+    }
+    return AVERROR(ENOENT);
+}
+
+/* Adds the variable an EXT-X-DEFINE tag defines to *vars. The master playlist's variables are kept
+ * only once it has been read, so an IMPORT in the master itself, or in a media playlist that no
+ * master loaded, finds none. */
+static int define_variable(HLSContext *c, AVDictionary **vars, const char *attributes,
+                           const char *url)
+{
+    struct define_info *info = av_mallocz(sizeof(*info));
+    const char *name, *value;
+    char *decoded = NULL;
+    int ret = AVERROR_INVALIDDATA;
+
+    if (!info)
+        return AVERROR(ENOMEM);
+    ff_parse_key_value(attributes, handle_define_args, info);
+    if (info->has_name + info->has_import + info->has_queryparam != 1) {
+        av_log(c->ctx, AV_LOG_ERROR, "EXT-X-DEFINE needs exactly one of NAME, IMPORT and "
+               "QUERYPARAM, in playlist %s\n", url);
+        goto end;
+    }
+    name = info->has_name ? info->name : info->has_import ? info->import : info->queryparam;
+    if (!is_variable_name(name)) {
+        av_log(c->ctx, AV_LOG_ERROR, "EXT-X-DEFINE names an invalid variable '%s', "
+               "in playlist %s\n", name, url);
+        goto end;
+    }
+    if (av_dict_get(*vars, name, NULL, AV_DICT_MATCH_CASE)) {
+        av_log(c->ctx, AV_LOG_ERROR, "Variable '%s' is defined twice, in playlist %s\n",
+               name, url);
+        goto end;
+    }
+    if (info->has_name) {
+        if (!info->has_value) {
+            av_log(c->ctx, AV_LOG_ERROR, "Variable '%s' has no VALUE, in playlist %s\n",
+                   name, url);
+            goto end;
+        }
+        value = info->value;
+    } else if (info->has_import) {
+        const AVDictionaryEntry *e;
+        if (!c->has_master) {
+            av_log(c->ctx, AV_LOG_ERROR, "Variable '%s' is imported by playlist %s, which no "
+                   "master playlist loaded\n", name, url);
+            goto end;
+        }
+        e = av_dict_get(c->master_vars, name, NULL, AV_DICT_MATCH_CASE);
+        if (!e) {
+            av_log(c->ctx, AV_LOG_ERROR, "Variable '%s' is imported by playlist %s, and the "
+                   "master playlist does not define it\n", name, url);
+            goto end;
+        }
+        value = e->value;
+    } else {
+        ret = find_query_parameter(url, name, &decoded);
+        if (ret == AVERROR(ENOENT)) {
+            av_log(c->ctx, AV_LOG_ERROR, "Variable '%s' comes from a query parameter that the "
+                   "URL of playlist %s does not carry with a value\n", name, url);
+            ret = AVERROR_INVALIDDATA;
+        }
+        if (ret < 0)
+            goto end;
+        ret = AVERROR_INVALIDDATA;
+        if (strpbrk(decoded, "\"\r\n")) {
+            av_log(c->ctx, AV_LOG_ERROR, "Variable '%s' takes a query parameter value that a "
+                   "quoted string cannot hold, in playlist %s\n", name, url);
+            goto end;
+        }
+        value = decoded;
+    }
+    ret = av_dict_set(vars, name, value, AV_DICT_MATCH_CASE);
+
+end:
+    av_free(decoded);
+    av_free(info);
+    return ret;
+}
+
+/* Replaces every variable reference in line, which holds line_size bytes, with its value. */
+static int substitute_variables(HLSContext *c, char *line, int line_size,
+                                const AVDictionary *vars, const char *url)
+{
+    AVBPrint out;
+    const char *p = line;
+    int ret = 0;
+
+    if (!strstr(line, "{$"))
+        return 0;
+    av_bprint_init(&out, 0, AV_BPRINT_SIZE_UNLIMITED);
+    while (*p) {
+        const char *start = p[0] == '{' && p[1] == '$' ? p + 2 : NULL;
+        const char *end = start;
+        if (start) {
+            while (is_variable_name_char(*end))
+                end++;
+        }
+        if (start && end > start && *end == '}') {
+            char name[MAX_VARIABLE_NAME_LEN];
+            const AVDictionaryEntry *e = NULL;
+            size_t len = end - start;
+            if (len < sizeof(name)) {
+                memcpy(name, start, len);
+                name[len] = 0;
+                e = av_dict_get(vars, name, NULL, AV_DICT_MATCH_CASE);
+            } else {
+                av_strlcpy(name, start, sizeof(name));
+            }
+            if (!e) {
+                av_log(c->ctx, AV_LOG_ERROR, "Variable '%s' is used before any EXT-X-DEFINE "
+                       "defines it, in playlist %s\n", name, url);
+                ret = AVERROR_INVALIDDATA;
+                goto end;
+            }
+            av_bprintf(&out, "%s", e->value);
+            p = end + 1;
+        } else {
+            av_bprint_chars(&out, *p, 1);
+            p++;
+        }
+    }
+    if (!av_bprint_is_complete(&out)) {
+        ret = AVERROR(ENOMEM);
+    } else if (out.len >= line_size) {
+        av_log(c->ctx, AV_LOG_ERROR, "A line of playlist %s is longer than %d bytes once its "
+               "variables are replaced\n", url, line_size - 1);
+        ret = AVERROR_INVALIDDATA;
+    } else {
+        memcpy(line, out.str, out.len + 1);
+    }
+
+end:
+    av_bprint_finalize(&out, NULL);
+    return ret;
+}
+
+/* Whether line is one whose variable references are replaced. */
+static int takes_variables(const char *line)
+{
+    return line[0] && (line[0] != '#' ||
+                       av_strstart(line, "#EXT-X-STREAM-INF:", NULL) ||
+                       av_strstart(line, "#EXT-X-MEDIA:", NULL) ||
+                       av_strstart(line, "#EXT-X-KEY:", NULL) ||
+                       av_strstart(line, "#EXT-X-MAP:", NULL));
+}
+
