+                        pls->ctx->streams[pls->pkt->stream_index]->codecpar->codec_type == AVMEDIA_TYPE_SUBTITLE)
+                        pkt_ts += pls->pkt->duration - 1;
+                    ts_diff = av_rescale_rnd(pkt_ts, AV_TIME_BASE,
                                             tb.den, AV_ROUND_DOWN) -
                             pls->seek_timestamp;
