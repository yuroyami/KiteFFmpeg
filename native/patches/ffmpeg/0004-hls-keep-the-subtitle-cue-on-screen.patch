          * stream */
         if (pls->needed && !pls->pkt->data) {
             while (1) {
-                int64_t ts_diff;
+                int64_t ts_diff, pkt_ts;
                 AVRational tb;
                 struct segment *seg = NULL;
                 if (pls->is_subtitle)
@@ -2774,7 +2774,15 @@ static int hls_read_packet(AVFormatContext *s, AVPacket *pkt)
                     }
 
                     tb = get_timebase(pls);
-                    ts_diff = av_rescale_rnd(pls->pkt->dts, AV_TIME_BASE,
+                    pkt_ts = pls->pkt->dts;
+                    /* KiteFFmpeg: a subtitle cue that began before the target and is still on
+                     * screen there belongs to it, so its last tick is compared rather than its
+                     * first. A subtitle playlist that starts late catches up to the newest packet
+                     * read, and comparing the start lost the cue showing at that moment. */
