+/**
+ * Write into buf the comma separated 3-letter codes that the language descriptors carry for a
+ * language tag, and return buf, or NULL when the tag gives none. A 3-letter entry stays as it
+ * is. A BCP 47 tag such as "en" or "pt-BR", as the HLS, DASH and Matroska demuxers report,
+ * gives the bibliographic ISO 639-2 code of the language its first subtag names. An entry of
+ * any other shape is left out.
+ */
+static const char *ts_language_codes(const char *tag, char *buf, size_t size)
+{
+    char item[64], code[4];
+    size_t len = 0;
+
+    for (const char *p = tag, *next; p; p = next ? next + 1 : NULL) {
+        size_t n;
+
+        next = strchr(p, ',');
+        n = next ? next - p : strlen(p);
+        if (n == 3) {
+            memcpy(code, p, 3);
+            code[3] = '\0';
+        } else if (n < sizeof(item)) {
+            memcpy(item, p, n);
+            item[n] = '\0';
+            if (ff_lang_tag_to_iso639_2(item, AV_LANG_ISO639_2_BIBL, code) < 0)
+                continue;
+        } else {
+            continue;
+        }
+        if (len + 5 > size)
+            break;
+        if (len)
+            buf[len++] = ',';
+        memcpy(buf + len, code, 4);
+        len += 3;
+    }
+    return len ? buf : NULL;
+}
