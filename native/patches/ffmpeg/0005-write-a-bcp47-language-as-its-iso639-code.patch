+
+static int is_ascii_letter(char c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+}
+
+int ff_lang_tag_to_iso639_2(const char *tag, enum AVLangCodespace target_codespace, char code[4])
+{
+    char primary[4];
+    const char *found;
+    size_t len = 0, i;
+
+    if (!tag || target_codespace == AV_LANG_ISO639_1)
+        return AVERROR(EINVAL);
+    while (len < 4 && is_ascii_letter(tag[len]))
+        len++;
+    if (len < 2 || len > 3 || (tag[len] && tag[len] != '-'))
+        return AVERROR(EINVAL);
+    for (i = len; tag[i]; i++)
+        if (!(is_ascii_letter(tag[i]) || av_isdigit(tag[i]) ||
+              (tag[i] == '-' && tag[i + 1] && tag[i + 1] != '-')))
+            return AVERROR(EINVAL);
+
+    for (i = 0; i < len; i++)
+        primary[i] = av_tolower(tag[i]);
+    primary[len] = '\0';
+
+    found = ff_convert_lang_to(primary, target_codespace);
+    if (len == 2) {
+        if (!found)
+            return AVERROR(EINVAL);
+        av_strlcpy(code, found, 4);
+        return 1;
+    }
+    av_strlcpy(code, found ? found : primary, 4);
+    /* BCP 47 spells a language that has a 2-letter code with that code only. */
+    return !ff_convert_lang_to(primary, AV_LANG_ISO639_1);
+}
