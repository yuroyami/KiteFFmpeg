+/**
+ * Find the 3-letter ISO 639-2 code of the language that a language tag names.
+ *
+ * The tag's first subtag, two or three letters in any case, names the language. The tag is
+ * either a BCP 47 (RFC 5646) tag such as "en", "pt-BR" or "zh-Hant", or an ISO 639-2 code,
+ * possibly followed by subtags as in the Matroska form "fre-ca". The subtags after the first
+ * are letters and digits, each one after a single hyphen.
+ *
+ * @param code receives the code, NUL terminated: the one in target_codespace, which is
+ *             AV_LANG_ISO639_2_BIBL or AV_LANG_ISO639_2_TERM, when the language has one, else
+ *             the first subtag itself
+ * @return 1 when tag is a BCP 47 tag, 0 when it starts with a 3-letter code that BCP 47 would
+ *         spell with two letters, AVERROR(EINVAL) when tag has another shape or names a
+ *         2-letter language with no ISO 639-2 code
+ */
+int ff_lang_tag_to_iso639_2(const char *tag, enum AVLangCodespace target_codespace, char code[4]);
+
 #endif /* AVFORMAT_AVLANGUAGE_H */
