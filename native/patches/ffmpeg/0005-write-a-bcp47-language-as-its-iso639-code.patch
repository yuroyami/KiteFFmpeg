+/**
+ * The language field of a track for a language tag: an ISO 639-2 code packed for MP4, or an
+ * index in the Macintosh table for MOV. A BCP 47 tag such as "en" or "pt-BR", as the HLS, DASH
+ * and Matroska demuxers report, gives the code of the language its first subtag names: the
+ * terminological one for MP4, as ISO/IEC 14496-12 asks, and either one for the MOV table.
+ */
+static int mov_language_code(const char *lang, int mp4)
+{
+    static const enum AVLangCodespace codespaces[] = { AV_LANG_ISO639_2_TERM, AV_LANG_ISO639_2_BIBL };
+    char code[4];
+    int ret = ff_mov_iso639_to_lang(lang, mp4);
+
+    for (int i = 0; ret < 0 && i < (mp4 ? 1 : 2); i++)
+        if (ff_lang_tag_to_iso639_2(lang, codespaces[i], code) >= 0)
+            ret = ff_mov_iso639_to_lang(code, mp4);
+    return ret < 0 ? 32767 : ret; // Unspecified Macintosh language code
+}
