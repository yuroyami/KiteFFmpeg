+/* KiteFFmpeg: reads a WebVTT timestamp, [hh:]mm:ss.ttt, in milliseconds. */
+static int read_vtt_time(const char *p, int64_t *ms)
+{
+    int64_t parts[3];
+    int n = 0;
+
+    for (;;) {
+        char *end;
+        if (!av_isdigit(*p) || n == 3)
+            return AVERROR_INVALIDDATA;
+        parts[n] = strtoll(p, &end, 10);
+        if (parts[n++] > INT32_MAX)
+            return AVERROR_INVALIDDATA;
+        p = end;
+        if (*p != ':')
+            break;
+        p++;
+    }
+    if (n < 2 || p[0] != '.' || !av_isdigit(p[1]) || !av_isdigit(p[2]) || !av_isdigit(p[3]))
+        return AVERROR_INVALIDDATA;
+    *ms = ((n == 3 ? parts[0] * 3600 : 0) + parts[n - 2] * 60 + parts[n - 1]) * 1000 +
+          (p[1] - '0') * 100 + (p[2] - '0') * 10 + (p[3] - '0');
+    return 0;
+}
+
+/* KiteFFmpeg: reads X-TIMESTAMP-MAP=MPEGTS:<ticks>,LOCAL:<time> from the header block of a WebVTT
+ * segment, the text before its first blank line (RFC 8216, section 3.5). The two settings may come
+ * in either order. */
+static int read_timestamp_map(const char *header, int64_t *mpegts, int64_t *local)
+{
+    static const char *const blank_lines[] = { "\n\n", "\r\n\r\n", "\r\r" };
+    const char *end = header + strlen(header), *p;
+    int have_mpegts = 0, have_local = 0;
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(blank_lines); i++) {
+        const char *blank = strstr(header, blank_lines[i]);
+        if (blank && blank < end)
+            end = blank;
+    }
+    p = strstr(header, "X-TIMESTAMP-MAP=");
+    if (!p || p >= end)
+        return AVERROR_INVALIDDATA;
+    p += strlen("X-TIMESTAMP-MAP=");
+    while (p < end && *p != '\r' && *p != '\n') {
+        const char *value;
+        while (*p == ' ' || *p == '\t')
+            p++;
+        if (av_strstart(p, "MPEGTS:", &value) && av_isdigit(*value)) {
+            *mpegts = strtoll(value, NULL, 10);
+            have_mpegts = 1;
+        } else if (av_strstart(p, "LOCAL:", &value)) {
+            have_local = read_vtt_time(value, local) >= 0;
+        }
+        p += strcspn(p, ",\r\n");
+        if (*p == ',')
+            p++;
+    }
+    return have_mpegts && have_local ? 0 : AVERROR_INVALIDDATA;
+}
+
+/* KiteFFmpeg: moves a cue of the WebVTT segment being read onto the clock of the other renditions,
+ * by the segment's X-TIMESTAMP-MAP: a cue at LOCAL belongs at MPEGTS. A segment without a map keeps
+ * its cue times, as RFC 8216 has it. MPEGTS is 33 bits wide, so it is unwrapped next to the newest
+ * packet read, which carries the wrap correction the media got, or else next to the last map. */
+static void shift_vtt_cue(HLSContext *c, struct playlist *v)
+{
+    AVPacket *pkt = v->pkt;
+
+    if (v->vtt_shift == AV_NOPTS_VALUE) {
+        const int64_t wrap = INT64_C(1) << 33;
+        AVRational tb = v->ctx->streams[pkt->stream_index]->time_base;
+        int64_t mpegts, local, ref;
+
+        v->vtt_shift = 0;
+        if (v->vtt_header_len <= 0 || read_timestamp_map(v->vtt_header, &mpegts, &local) < 0)
+            return;
+        ref = c->cur_timestamp != AV_NOPTS_VALUE ?
+              av_rescale_q(c->cur_timestamp, AV_TIME_BASE_Q, MPEG_TIME_BASE_Q) : v->vtt_mpegts;
+        if (ref != AV_NOPTS_VALUE) {
+            int64_t d = ref - mpegts;
+            mpegts += (d >= 0 ? (d + wrap / 2) / wrap : -((wrap / 2 - d) / wrap)) * wrap;
+        }
+        v->vtt_mpegts = mpegts;
+        v->vtt_shift  = av_rescale_q(mpegts, MPEG_TIME_BASE_Q, tb) -
+                        av_rescale_q(local, (AVRational){ 1, 1000 }, tb);
+    }
+    if (pkt->pts != AV_NOPTS_VALUE)
+        pkt->pts = av_sat_add64(pkt->pts, v->vtt_shift);
+    if (pkt->dts != AV_NOPTS_VALUE)
+        pkt->dts = av_sat_add64(pkt->dts, v->vtt_shift);
+}
+
 static int read_subtitle_packet(struct playlist *v, AVPacket *pkt)
 {
     HLSContext *c = v->parent->priv_data;
@@ -2394,6 +2513,7 @@ restart:
 
     ret = av_read_frame(v->ctx, v->pkt);
     if (!ret) {
+        shift_vtt_cue(c, v);
         return ret;
     }
     ff_format_io_close(v->parent, &v->input);
