     int has_sidx;  // If there is an sidx entry for this stream.
+    int has_elng;  // If an elng box gave this stream its language.
     struct {
         struct AVAESCTR* aes_ctr;
         struct AVAES *aes_ctx;
diff --git a/libavformat/mov.c b/libavformat/mov.c
index e7e29d7..867882f 100644
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -1961,13 +1961,44 @@ static int mov_read_mdhd(MOVContext *c, AVIOContext *pb, MOVAtom atom)
     }
 
     lang = avio_rb16(pb); /* language */
-    if (ff_mov_lang_to_iso639(lang, language))
+    if (!sc->has_elng && ff_mov_lang_to_iso639(lang, language))
         av_dict_set(&st->metadata, "language", language, 0);
     avio_rb16(pb); /* quality */
 
     return 0;
 }
 
+/**
+ * The extended language tag box of ISO/IEC 14496-12 and QuickTime holds a whole BCP 47 tag, such
+ * as "zh-Hant" or "pt-BR", where mdhd holds only a three-letter code. A non-empty one is the
+ * stream's language, whichever of the two boxes comes first.
+ */
+static int mov_read_elng(MOVContext *c, AVIOContext *pb, MOVAtom atom)
+{
+    AVStream *st;
+    MOVStreamContext *sc;
+    char tag[256];
+    int ret;
+
+    if (c->fc->nb_streams < 1 || atom.size < 5 || atom.size - 4 >= (int64_t)sizeof(tag))
+        return 0;
+    st = c->fc->streams[c->fc->nb_streams-1];
+    sc = st->priv_data;
+
+    if (avio_r8(pb) != 0) /* version */
+        return 0;
+    avio_rb24(pb); /* flags */
+    ret = ffio_read_size(pb, tag, atom.size - 4);
+    if (ret < 0)
+        return ret;
+    tag[atom.size - 4] = '\0';
+    if (!tag[0])
+        return 0;
+
+    sc->has_elng = 1;
+    return av_dict_set(&st->metadata, "language", tag, 0);
+}
+
