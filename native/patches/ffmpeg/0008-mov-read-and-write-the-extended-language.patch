diff --git a/libavformat/movenc.c b/libavformat/movenc.c
index 847f395..c780b11 100644
--- a/libavformat/movenc.c
+++ b/libavformat/movenc.c
@@ -3955,6 +3955,28 @@ static int mov_write_mdhd_tag(AVIOContext *pb, MOVMuxContext *mov,
     return 32;
 }
 
+/**
+ * The extended language tag box of ISO/IEC 14496-12 and QuickTime: the stream's whole BCP 47 tag,
+ * for a track whose tag says more than the code mdhd holds, so that a reader can tell "zh-Hant"
+ * from "zh-Hans" or "pt-BR" from "pt-PT". A track whose tag is a code writes none.
+ */
+static int mov_write_elng_tag(AVIOContext *pb, MOVTrack *track)
+{
+    const AVDictionaryEntry *lang;
+    int64_t pos = avio_tell(pb);
+
+    if (!track->extended_language || !track->st)
+        return 0;
+    lang = av_dict_get(track->st->metadata, "language", NULL, 0);
+    if (!lang)
+        return 0;
+    avio_wb32(pb, 0); /* size */
+    ffio_wfourcc(pb, "elng");
+    avio_wb32(pb, 0); /* version and flags */
+    avio_put_str(pb, lang->value);
+    return update_size(pb, pos);
+}
+
 static int mov_write_mdia_tag(AVFormatContext *s, AVIOContext *pb,
                               MOVMuxContext *mov, MOVTrack *track)
 {
@@ -3965,6 +3987,7 @@ static int mov_write_mdia_tag(AVFormatContext *s, AVIOContext *pb,
     ffio_wfourcc(pb, "mdia");
     mov_write_mdhd_tag(pb, mov, track);
     mov_write_hdlr_tag(s, pb, track);
+    mov_write_elng_tag(pb, track);
     if ((ret = mov_write_minf_tag(s, pb, mov, track)) < 0)
         return ret;
     return update_size(pb, pos);
@@ -8147,6 +8170,34 @@ static int mov_language_code(const char *lang, int mp4)
     return ret < 0 ? 32767 : ret; // Unspecified Macintosh language code
 }
 
+/**
+ * 1 when lang is a well-formed BCP 47 tag that says more than code, the language field of the
+ * media header, can hold: a script, a region or another subtag after the language, as in
+ * "zh-Hant" or "pt-BR", or a language that field has no code for. A code alone, or a two-letter
+ * code that has a three-letter one, says nothing more, and neither does a string that is not a
+ * tag, such as "English" or a list of codes.
+ */
+static int mov_language_needs_elng(const char *lang, int code)
+{
+    static const char letters[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
+    static const char alnum[] = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
+    size_t first = strspn(lang, letters);
+    const char *p = lang + first;
+
+    /* A language of two or three letters, or x or i, which lead a private or grandfathered tag. */
+    if (first < 1 || first > 3 || (first == 1 && !strchr("xXiI", lang[0])) || (*p && *p != '-'))
+        return 0;
+    while (*p) {
+        size_t len = strspn(++p, alnum);
+        if (len < 1 || len > 8 || (p[len] && p[len] != '-'))
+            return 0;
+        p += len;
+    }
+    if (lang[first])
+        return 1;
+    return first > 1 && code == 32767 && av_strcasecmp(lang, "und");
+}
+
 static int mov_init(AVFormatContext *s)
 {
     MOVMuxContext *mov = s->priv_data;
@@ -8475,6 +8526,8 @@ static int mov_init(AVFormatContext *s)
             continue;
 
         track->language = mov_language_code(lang ? lang->value : "und", mov->mode != MODE_MOV);
+        track->extended_language = lang && (mov->mode & (MODE_MP4 | MODE_MOV | MODE_IPOD)) &&
+                                   mov_language_needs_elng(lang->value, track->language);
         track->mode = mov->mode;
         if (!track->tag)
             track->tag  = mov_find_codec_tag(s, track);
