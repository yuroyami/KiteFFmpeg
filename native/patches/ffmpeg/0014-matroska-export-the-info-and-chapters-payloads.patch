  * Allocate and return the entry for the level1 element with the given ID. If
  * an entry already exists, return the existing entry.
  */
+/* The largest Info or Chapters payload exported; a larger one is parsed as before and not exported. */
+#define MATROSKA_EXPORT_MAX (16 << 20)
+
+static int matroska_exports_payload(uint32_t id)
+{
+    return id == MATROSKA_ID_INFO || id == MATROSKA_ID_CHAPTERS;
+}
+
+/* Reads back the payload of the Info or Chapters element just parsed, from start to the current
+ * position, and keeps the first one of each. The caller kept the span in the buffer, so the read
+ * reaches no protocol. A payload that cannot be read back is not exported, and the reader goes on
+ * from where it was. */
+static int matroska_export_payload(MatroskaDemuxContext *matroska, uint32_t id,
+                                   int64_t start, uint64_t length)
+{
+    AVIOContext *pb = matroska->ctx->pb;
+    int64_t end = avio_tell(pb);
+    uint8_t **dst = id == MATROSKA_ID_INFO ? &matroska->info_payload : &matroska->chapters_payload;
+    int *dst_size = id == MATROSKA_ID_INFO ? &matroska->info_payload_size : &matroska->chapters_payload_size;
+    uint8_t *buf;
+
+    if (*dst || length == EBML_UNKNOWN_LENGTH || length > MATROSKA_EXPORT_MAX ||
+        end != start + (int64_t)length)
+        return 0;
+    /* One byte more, so that an empty payload still reads as exported. */
+    buf = av_malloc(length + 1);
+    if (!buf)
+        return 0;
+    if (avio_seek(pb, start, SEEK_SET) == start && avio_read(pb, buf, length) == length) {
+        *dst      = buf;
+        *dst_size = length;
+        return 0;
+    }
+    av_free(buf);
+    return avio_seek(pb, end, SEEK_SET) == end ? 0 : AVERROR(EIO);
+}
