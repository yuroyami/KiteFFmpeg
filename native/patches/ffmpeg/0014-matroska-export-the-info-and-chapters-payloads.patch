+/**
+ * Like ffio_ensure_seekback(), but keeps the window in the buffer even when
+ * the context can seek, so that seeking back within it never reaches the
+ * underlying protocol: for a caller that reads the same bytes twice and must
+ * not cost a second request, or fail on one.
+ */
+int ffio_ensure_buffered(AVIOContext *s, int64_t buf_size);
+
