+/* The edition RFC 9559 makes the default one (section 20.1.2): the first one flagged default, or the
+ * first one when none is. NULL when the file has no chapters. */
+static MatroskaEdition *matroska_default_edition(MatroskaDemuxContext *matroska)
+{
+    MatroskaEdition *editions = matroska->editions.elem;
+    for (int i = 0; i < matroska->editions.nb_elem; i++)
+        if (editions[i].flag_default)
+            return &editions[i];
+    return matroska->editions.nb_elem ? &editions[0] : NULL;
+}
+
+/* Whether a chapter plays another segment, so that its times are that segment's and not this one's.
+ * A ChapterSegmentUUID equal to this segment's own UID breaks the specification and names this
+ * segment. */
+static int matroska_chapter_is_linked(const MatroskaDemuxContext *matroska,
+                                      const MatroskaChapter *chapter)
+{
+    const EbmlBin *own = &matroska->segment_uid;
+    if (!chapter->segment_uid.size)
+        return 0;
+    return own->size != chapter->segment_uid.size ||
+           memcmp(own->data, chapter->segment_uid.data, own->size);
+}
