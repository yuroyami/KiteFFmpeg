+/**
+ * Add what Apple's vexu and hfov boxes say to what Google's st3d, sv3d or spherical uuid box
+ * said, whatever order they came in. Where both state the same thing and disagree, Google's
+ * description is kept whole; Apple's fills in what Google's cannot say.
+ */
+static void mov_merge_vexu(MOVStreamContext *sc)
+{
+    AVStereo3D *google = sc->stereo3d;
+    const AVStereo3D *apple = sc->vexu_stereo3d;
+
+    if (sc->vexu_spherical && !sc->spherical) {
+        sc->spherical      = sc->vexu_spherical;
+        sc->spherical_size = sc->vexu_spherical_size;
+        sc->vexu_spherical = NULL;
+    }
+    /* Otherwise Google's mapping states the projection too, and the turn and the bounds that
+     * Apple's proj box has no room for. */
+    av_freep(&sc->vexu_spherical);
+
+    if (!apple)
+        return;
+    if (!google) {
+        sc->stereo3d      = sc->vexu_stereo3d;
+        sc->stereo3d_size = sc->vexu_stereo3d_size;
+        sc->vexu_stereo3d = NULL;
+        return;
+    }
+
+    /* Google's two views are packed with the left eye's first. Apple's eyes and pack boxes
+     * agree with that when they say both views, not reversed, packed the same way or packed in
+     * a way they do not say, and then they add the primary eye, the baseline and the disparity
+     * adjustment. */
+    if (apple->type != AV_STEREO3D_2D &&
+        google->type != AV_STEREO3D_2D &&
+        !(apple->flags & AV_STEREO3D_FLAG_INVERT) &&
+        apple->view == AV_STEREO3D_VIEW_PACKED &&
+        (apple->type == AV_STEREO3D_UNSPEC || apple->type == google->type)) {
+        google->primary_eye                     = apple->primary_eye;
+        google->baseline                        = apple->baseline;
+        google->horizontal_disparity_adjustment = apple->horizontal_disparity_adjustment;
+    }
+    /* The field of view describes the lens rather than the views, and Google's boxes never
+     * state one. */
+    if (apple->horizontal_field_of_view.num)
+        google->horizontal_field_of_view = apple->horizontal_field_of_view;
+
+    av_freep(&sc->vexu_stereo3d);
+}
