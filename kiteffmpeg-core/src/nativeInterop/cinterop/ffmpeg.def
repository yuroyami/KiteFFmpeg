package = ffmpeg
language = C
# kitecodec_abi.h comes LAST, after kitecodec_helpers.h. Order matters for one reason: both headers
# define KC_API, kitecodec_abi.h guards its own definition with #ifndef, and listing it last means the
# helper header's unguarded definition is always the one that wins. It includes no FFmpeg header and
# names no FFmpeg type, so nothing it adds can pull a new libav type into the binding; what it adds is
# the identity gate of register item B1-02 and the six kc_ functions register item B1-22 moves behind it.
headers = kitecodec_helpers.h kitecodec_handles.h kitecodec_abi.h
headerFilter = kitecodec_helpers.h kitecodec_handles.h kitecodec_abi.h
# THE VENDORED/PUBLISHED DEF (KC-EMBED, 2026-08-22). Every archive below is embedded INTO this
# cinterop klib and rides it through publication, exactly as libkitecodec.a always has (verified:
# the published klib carries default/targets/<t>/included/*.a). A consumer therefore needs ONLY
# the dependency line; no plugin, no -L, no FFmpeg install.
#
# ORDER IS LOAD-BEARING on ELF: dependents before dependencies. libkitecodec draws from all six
# libav*; libavformat from libavcodec; libavfilter from swscale/swresample; everything from
# libavutil; libavcodec from libdav1d, which is why dav1d is LAST. There is deliberately no
# libraryPaths entry: a def-relative path resolves against the Gradle project directory, and the
# directories are per konan target, so search paths arrive as -libraryPath from
# kiteffmpeg-core/build.gradle.kts.
staticLibraries = libkitecodec.a libavformat.a libavcodec.a libavfilter.a libswscale.a libswresample.a libavutil.a libdav1d.a
# Platform flags only: the archives are embedded, so no -lav* here (a -l flag would make every
# consumer link fail with "library not found"). What a STATIC libav* still draws from the
# platform must be named, and these lines ride the klib to the consumer's link.
# Apple: SDK zlib plus the media frameworks the VideoToolbox/AudioToolbox codecs reference.
linkerOpts.osx = -lz -framework CoreFoundation -framework CoreMedia -framework CoreVideo -framework VideoToolbox -framework AudioToolbox
linkerOpts.ios = -lz -framework CoreFoundation -framework CoreMedia -framework CoreVideo -framework VideoToolbox -framework AudioToolbox
# Linux: zlib, maths, dynamic loader, pthreads, all from the konan sysroot / OS.
linkerOpts.linux = -lz -lm -ldl -lpthread
# Windows: zlib + iconv from the msys2 sysroot (iconv backs subtitle charset conversion and the
# mingw configure autodetects it), plus the sockets, media and COM APIs FFmpeg reaches for.
linkerOpts.mingw = -lz -liconv -lws2_32 -lbcrypt -lsecur32 -lmfplat -lole32 -lstrmiids -luuid
# Android: the MediaCodec wrapper needs mediandk + JNI glue; zlib + log are NDK staples.
linkerOpts.android = -lmediandk -landroid -llog -lz
