package = ffmpeg
language = C
# The DEV-FALLBACK def, selected by kiteffmpeg/build.gradle.kts when no vendored tree exists
# for the target (a host with only a shared brew/apt FFmpeg). Shared libav* dylibs resolve their
# own dependencies, so plain -l flags are the whole story; nothing FFmpeg-side is embedded. The
# header block is IDENTICAL to ffmpeg.def and must stay so: same binding, different linking.
headers = kitecodec_helpers.h kitecodec_handles.h kitecodec_abi.h
headerFilter = kitecodec_helpers.h kitecodec_handles.h kitecodec_abi.h
linkerOpts.osx = -lavformat -lavcodec -lavfilter -lavutil -lswscale -lswresample
linkerOpts.linux = -lavformat -lavcodec -lavfilter -lavutil -lswscale -lswresample
# The helper archive still embeds exactly as in ffmpeg.def; its -libraryPath comes from the
# build script per konan target.
staticLibraries = libkitecodec.a
