# The SHA-256 of every prebuilt FFmpeg zip of the release ffmpeg-n9.0.2-r3 (#188).
# Every workflow checks a fetched zip against this file, never against the release's own
# .sha256, which a rerun of release-binaries.yml could replace together with the zip.
# Raising FFMPEG_ASSET_TAG means writing the new release's digests here in the same commit.
release: ffmpeg-n9.0.2-r3
