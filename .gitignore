.idea/
.gradle/
.kotlin/
build/
**/build/
local.properties
.DS_Store
captures/
*.iml
*.hprof
**/.kotlin-build-tools/

# Intentionally do not ignore kotlin-js-store/yarn.lock. Kotlin/JS and Wasm use it as the
# reproducible dependency lock for their Node/browser build and test tooling.

# Source tarballs / submodule build artefacts.
# The whole vendor/ tree: the docs tell you to `git clone ... vendor/ffmpeg`, which is ~10k
# files of someone else's source, and it must never show up in `git status` as untracked noise.
vendor/
native-libs/

# native/kitecodec-c/tools/extract_from_def.py is a committed generator, so importing it or
# running py_compile over it leaves bytecode next to it. That is output, not source.
__pycache__/
*.pyc

# Local runs of .github/scripts/package-ffmpeg.sh
/dist/

# JVM crash dumps. Four were committed by accident and carried local paths.
hs_err_pid*.log
replay_pid*.log
